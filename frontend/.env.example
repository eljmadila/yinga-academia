# API base URL (includes /api suffix)
# Local: http://localhost:8000/api
# Production (Render): https://yinga-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://yinga-backend.onrender.com/api

# Backend origin (no /api, used for media/video streaming)
# Local: http://localhost:8000
# Production (Render): https://yinga-backend.onrender.com
NEXT_PUBLIC_BACKEND_ORIGIN=https://yinga-backend.onrender.com

# Frontend Site URL
# Local: http://localhost:3000
# Production (Vercel): https://yinga-academia.vercel.app
NEXT_PUBLIC_SITE_URL=https://yinga-academia.vercel.app

# Sentry error tracking (optional, leave empty in local dev)
NEXT_PUBLIC_SENTRY_DSN=