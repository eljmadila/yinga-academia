{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/ui/**/*.ts",
    "src/components/ui/**/*.tsx",
    "src/components/instructor/**/*.ts",
    "src/components/instructor/**/*.tsx",
    "src/components/student/**/*.ts",
    "src/components/student/**/*.tsx",
    "src/components/common/**/*.ts",
    "src/components/common/**/*.tsx",
    "src/components/header/**/*.ts",
    "src/components/header/**/*.tsx",
    "src/components/auth/**/*.ts",
    "src/components/auth/**/*.tsx",
    "src/components/public/**/*.ts",
    "src/components/public/**/*.tsx",
    "src/components/videos/**/*.ts",
    "src/components/videos/**/*.tsx",
    "src/components/charts/**/*.ts",
    "src/components/charts/**/*.tsx",
    "src/components/calendar/**/*.ts",
    "src/components/calendar/**/*.tsx",
    "src/components/user-profile/**/*.ts",
    "src/components/user-profile/**/*.tsx",
    "src/components/LessonQA.tsx",
    "src/context/ThemeContext.tsx",
    "src/hooks/use-mobile.ts",
    "src/hooks/useClickOutside.ts",
    "src/hooks/useModal.ts",
    "src/hooks/useGoBack.ts",
    "src/i18n/**/*.ts",
    "src/i18n/**/*.tsx",
    "src/lib/api.ts",
    "src/lib/utils.ts",
    "src/utils.ts",
    "src/middleware.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "garbage_backup",
    "src/app_temp",
    ".next"
  ]
}
